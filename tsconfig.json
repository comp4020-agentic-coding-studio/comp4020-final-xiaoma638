{
  // Covers the app (src/) and the supplied harness (spec/, scripts/).
  // SvelteKit writes $app/tsconfig on `svelte-kit sync`: its path aliases and
  // generated route types.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "$app/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "src", "spec", "scripts"]
}
